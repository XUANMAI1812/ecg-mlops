# syntax=docker/dockerfile:1
# Môi trường huấn luyện: train, tinh chỉnh tham số (tune), đánh giá trên CPU.
# Image không chứa dữ liệu, không chứa secret; dữ liệu và thư mục kết quả được
# mount lúc chạy. Build và chạy: docs/setup.md mục 15.

ARG PYTHON_IMAGE=python:3.12.16-slim-bookworm

FROM ${PYTHON_IMAGE} AS builder
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
COPY requirements/dev.txt /tmp/requirements/dev.txt
# Cài torch bản CPU từ index riêng trước. dev.txt pin torch==<phiên bản> nên bước
# sau giữ nguyên bản <phiên bản>+cpu, không tải bản CUDA từ PyPI.
RUN TORCH_VERSION="$(grep -E '^torch==' /tmp/requirements/dev.txt | cut -d= -f3)" \
    && pip install "torch==${TORCH_VERSION}" --index-url "${TORCH_INDEX_URL}" \
    && pip install -r /tmp/requirements/dev.txt \
    && pip check

FROM ${PYTHON_IMAGE}
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONPATH=/app/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MLFLOW_DISABLE_TELEMETRY=true \
    DO_NOT_TRACK=1 \
    GIT_PYTHON_REFRESH=quiet \
    HOME=/tmp
COPY --from=builder /opt/venv /opt/venv
WORKDIR /app
COPY src/ src/
COPY scripts/ scripts/
RUN useradd --no-create-home --shell /usr/sbin/nologin --uid 10001 app
USER app
# Tham số đầu tiên của docker run là module cần chạy, ví dụ ecg.models.train.
ENTRYPOINT ["python", "-m"]
CMD ["ecg.models.train", "--help"]
